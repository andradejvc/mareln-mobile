{
  "expo": {
    "name": "Maré LN",
    "slug": "mareln-mobile",
    "scheme": "mareln",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "br.com.mareln.mobile"
    },
    "ios": {
      "bundleIdentifier": "br.com.mareln.mobile"
    }
  }
}
